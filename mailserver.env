# ── General ──
OVERRIDE_HOSTNAME=masterly-air-academy.dz
POSTMASTER_ADDRESS=admin@masterly-air-academy.dz

# ── Accounts ──
# Format: user@domain|{SHA512-CRYPT}hash
# Create with: docker exec -it <container> setup email add admin@masterly-air-academy.dz

# ── TLS ──
SSL_TYPE=letsencrypt

# ── Security ──
ENABLE_SPAMASSASSIN=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
FAIL2BAN_IGNORE_IP=172.16.0.0/12 127.0.0.0/8
ENABLE_POSTGREY=0
POSTFIX_INET_PROTOCOLS=ipv4

# ── DKIM ──
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1

# ── Policies ──
SPOOF_PROTECTION=1
ENABLE_SRS=1
PERMIT_DOCKER=connected-networks

# ── Quotas ──
POSTFIX_MAILBOX_SIZE_LIMIT=0
POSTFIX_MESSAGE_SIZE_LIMIT=25600000
